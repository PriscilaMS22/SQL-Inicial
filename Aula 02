## Há também a atualização de dados cadastrais, por exemplo, e usamos o comando UPDATE. 
## ATENÇÃO!! ## SEMPRE PREENCHER A CONDIÇÃO 'WHERE' NO FINAL DO COMANDO UPDATE, SENÃO VAI ATUALIZAR TODOS OS REGISTROS DA TABELA E NÃO SÓ O SELECIONADO!!!
  
  UPDATE endereco
  	set numero = '437'
    WHERE matriculaint = 1


## Para atualizar vários dados de um cliente de uma vez só, não repetir o comando SET e separar os dados por vírgulas

    UPDATE cliente
      set idade = '59',
    	estado_civil = 'DV',
      sexo = 'M',
      uf = 'MG'
    WHERE matriculaint = 3
    

## Se você quiser forçar uma atualização cadastral em todos os clientes, você seta o update como NULL e os dados serão "apagados"
    
    UPDATE cliente
    set uf=null, estado=null

    
## Deletar linhas de tabelas já populadas EXIGE O USO DA CONDIÇÃO 'WHERE' TAMBÉM!! SENÃO APAGA TODOS OS DADOS!!
    
  DELETE FROM cliente 
  WHERE matriculaint = 3

  
