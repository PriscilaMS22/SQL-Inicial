## Bulk load: são comandos de cargas, ou seja, carregam grandes volumes de dados para a tabela de uma vez só, como por exemplo>

  
 CREATE TABLE endereco (
    enderecoID int PRIMARY KEY,
    logradouro varchar(50) not NULL,
    numero integer (4),
    bairro varchar(30),
    CEP INT CHECK (CEP BETWEEN 10000000 and 99999999),
    matriculaint integer REFERENCES cliente(matriculaint)
    )

