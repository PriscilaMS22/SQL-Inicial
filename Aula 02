CREATE TABLE cliente (
  matriculaint integer PRIMARY KEY,
  nome varchar(50) NOT NULL,
  idade integer CHECK (idade >= 0 and idade <=99),
  estado char (2),
  estadocivil char(2),
  sexo varchar(2)
  )
  ALTER TABLE cliente DROP COLUMN estado;
  ALTER TABLE cliente ADD COLUMN UF char(2);
  ALTER TABLE cliente RENAME COLUMN estadocivil to estado_civil;


